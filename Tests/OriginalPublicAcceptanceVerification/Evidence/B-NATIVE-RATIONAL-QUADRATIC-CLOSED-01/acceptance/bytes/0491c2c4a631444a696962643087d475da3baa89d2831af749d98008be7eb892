    static func capOracle(_ receipt:Cap, reversed:Bool, using a:inout ExactScalarLedger) throws {
        let law=receipt.law,field=law.field,ring=law.polynomials
        func q(_ n:Int,_ d:Int = 1) throws -> Field.Value {
            try field.dividing(field.integer(n,using:&a),field.integer(d,using:&a),using:&a)
        }
        func poly(_ coefficients:[(Int,Int)]) throws -> ExactPolynomial<Field> {
            var terms:[ExactPolynomialTerm<Field.Value>] = []
            for (power,value) in coefficients.enumerated() where value.0 != 0 {
                terms.append(.init(powers:[power],coefficient:try q(value.0,value.1)))
            }
            return try ring.polynomial(terms:terms,using:&a)
        }
        let expectedX = reversed ? [(0,1),(3,2),(-1,1)] : [(1,2),(1,2),(-1,1)]
        let expectedY = reversed ? [(0,1),(3,2),(-5,4)] : [(1,4),(1,1),(-5,4)]
        let expected=[try poly(expectedX),try poly(expectedY),try ring.zero(using:&a),try poly([(1,1),(4,1),(-4,1)])]
        try require(law.homogeneous.count==4 && law.support.count==1 && law.chart.selection.spans == [2])
        for i in expected.indices { try require(ring.equals(law.homogeneous[i],expected[i],using:&a)) }
        try require(field.compare(law.support[0].lower,q(0),using:&a) == .equal && field.compare(law.support[0].upper,q(1),using:&a) == .equal)
        try require(law.parameterTransport.numerators.count==1 && law.parameterTransport.denominators.count==1)
        try require(ring.equals(law.parameterTransport.numerators[0],poly([(0,1),(1,1)]),using:&a))
        try require(ring.equals(law.parameterTransport.denominators[0],poly([(1,1)]),using:&a))
        let rows = reversed ? [[0,-4,1],[-4,8,0],[4,-4,0]] : [[4,-4,0],[-4,8,0],[0,-4,1]]
