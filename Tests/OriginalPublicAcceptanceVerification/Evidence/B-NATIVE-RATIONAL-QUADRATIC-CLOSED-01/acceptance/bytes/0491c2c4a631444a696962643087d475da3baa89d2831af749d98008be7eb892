/// Whole-cell acceptance for the authored directed positive rational quadratic cap.
@main struct RationalQuadraticBoundaryAcceptance {
    typealias Fixture = M6ExactBoundaryFixtures
    typealias Base = ExactRationalScalarDomain
    typealias Field = Fixture.Field
    typealias Cells = ExactRealCellDomain<Base>
    typealias Raw = Fixture.Raw
    typealias Result = OriginalExactFaceClippedParameters
    enum Failure: Error { case assertion(Int), unexpectedSuccess, unknownGroup }

    static func require(_ condition: Bool, line: Int = #line) throws {
        guard condition else {
#if !hasFeature(Embedded)
            print("FAIL rational quadratic boundary assertion", line)
#else
            print("FAIL rational quadratic boundary assertion")
#endif
            throw Failure.assertion(line)
        }
    }
    static func pcurves() -> [SurfaceParameterCurve] {
        [.constantV(v:0,uStart:0,uEnd:0.5),
         .constantU(u:0.5,vStart:0,vEnd:0.25),
         .bSpline(.init(degree:2,knots:[0,0,0,1,1,1],
             controlPoints:[.init(x:0.5,y:0.25),.init(x:0.25,y:0.25),.init(x:0,y:0)],
             weights:[1,3,1]))]
    }
    static func prepare() throws -> (Raw, Fixture.FaceOwner) {
        var a = try Fixture.ledger()
        let field = try Field.base(field:Base(),maximumExtensionLevel:10,using:&a)
        let surface = Fixture.plane(), curve = Fixture.line(y:7.0/32)
        let raw = try Fixture.raw(curve,surface,field,&a)
        let owner = try Fixture.face(surface,[(.outer,pcurves())])
        try require(owner.0.validationLevel == .exact)
        return (raw,owner)
    }
    static func checkMap(_ map: ExactParametricMap<Base>, surface: Bool,
        using a: inout ExactScalarLedger) throws {
        let cells = try Cells(retaining:map.original,using:&a), ring = cells.polynomials
        let field = try cells.coefficientField(of:map.original,using:&a)
        let zero = try ring.zero(using:&a), one = try ring.constant(field.integer(1,using:&a),using:&a)
        let u = try ring.variable(0,using:&a)
        let y = try ring.constant(field.dividing(field.integer(7,using:&a),field.integer(32,using:&a),using:&a),using:&a)
        let expected = surface ? [u,try ring.variable(1,using:&a),zero,one] : [u,y,zero,one]
        try require(map.parameterCount == (surface ? 2:1) && map.original.polynomials.count == 4)
        for index in expected.indices { try require(ring.equals(map.original.polynomials[index],expected[index],using:&a)) }
        for domain in map.original.domains {
            guard case .finite(let lo) = domain.lower, case .finite(let hi) = domain.upper else { throw Failure.assertion(#line) }
            try require(domain.includesLower && domain.includesUpper && !domain.isEmpty)
            try require(field.compare(lo,field.integer(0,using:&a),using:&a) == .equal)
            try require(field.compare(hi,field.integer(1,using:&a),using:&a) == .equal)
        }
    }
    static func proofs(_ partition: ExactRealCellPartition<Base>, refined: Bool, chord: Bool,
        hole: Bool, using a: inout ExactScalarLedger) throws -> (Cells,[ExactRealCellSignInvariant<Base>?]) {
        let cells = try Cells(retaining:partition.source,using:&a), ring = cells.polynomials
        let field = try cells.coefficientField(of:partition.source,using:&a)
        let t = try ring.variable(0,using:&a), u = try ring.variable(1,using:&a), v = try ring.variable(2,using:&a)
        func c(_ n:Int,_ d:Int = 1) throws -> ExactPolynomial<Field> {
            try ring.constant(field.dividing(field.integer(n,using:&a),field.integer(d,using:&a),using:&a),using:&a)
        }
        let one = try c(1)
        var laws = [t,try ring.subtracting(t,one,using:&a),u,try ring.subtracting(u,one,using:&a),
            v,try ring.subtracting(v,one,using:&a),try ring.subtracting(u,t,using:&a),try ring.subtracting(v,c(7,32),using:&a)]
        if refined {
            if chord { laws.append(try ring.subtracting(t,c(7,16),using:&a)) }
            else {
                // On the retained unit T domain, 7/4-T is strictly positive.
                let factor = try ring.multiplying(ring.subtracting(t,c(1,4),using:&a),
                    ring.subtracting(c(7,4),t,using:&a),using:&a)
                let expanded = try ring.subtracting(ring.subtracting(ring.scaled(t,by:field.integer(2,using:&a),using:&a),
                    ring.multiplying(t,t,using:&a),using:&a),c(7,16),using:&a)
                try require(ring.equals(factor,expanded,using:&a))
                laws.append(factor)
            }
            laws.append(try ring.subtracting(t,c(1,2),using:&a))
            if hole {
                laws.append(try ring.subtracting(t,c(3,8),using:&a))
                laws.append(try ring.subtracting(t,c(7,16),using:&a))
            }
        }
        var result:[ExactRealCellSignInvariant<Base>?] = []
        for (index,law) in laws.enumerated() {
            if refined && !chord && [4,5,7].contains(index) { result.append(nil);continue }
            guard let proof = try cells.signInvariant(for:law,in:partition,using:&a) else {
#if !hasFeature(Embedded)
                print("MISSING whole sign law",index,"refined",refined,"chord",chord)
#endif
                throw Failure.assertion(#line)
            }
            result.append(proof)
        }
        return (cells,result)
    }
    static func signs(_ proofs:[ExactRealCellSignInvariant<Base>?],cells:Cells,cell:ExactRealCellID<Base>,
        using a:inout ExactScalarLedger) throws -> [ExactSign] {
        try proofs.enumerated().map { index,proof in
            if let proof { return try cells.sign(of:proof,at:cell,using:&a) }
            switch index { case 4:return .positive;case 5:return .negative;case 7:return .zero
            default:throw Failure.assertion(#line) }
        }
    }
    static func scopedOracle(_ refinement:OriginalExactBoundaryRefinement,chord:Bool,
        using a:inout ExactScalarLedger) throws {
        let raw = refinement.parameters.raw, pullback = refinement.parameters.pullback
        let cells = try Cells(retaining:pullback.region.partition.source,using:&a),ring = cells.polynomials
        let field = try cells.coefficientField(of:pullback.region.partition.source,using:&a)
        let zero = try field.integer(0,using:&a),one = try field.integer(1,using:&a)
        let y = try field.dividing(field.integer(7,using:&a),field.integer(32,using:&a),using:&a)
        let original = raw.original.predicate.source.domains,target = pullback.target.source.domains
        try require(original.count == 3 && target.count == 3)
        for index in original.indices {
            guard case .finite(let lo) = original[index].lower,case .finite(let hi) = original[index].upper,
                case .finite(let targetLo) = target[index].lower,case .finite(let targetHi) = target[index].upper else {
                throw Failure.assertion(#line)
            }
            try require(original[index].includesLower && original[index].includesUpper && !original[index].isEmpty)
            try require(target[index].includesLower && target[index].includesUpper && !target[index].isEmpty)
            try require(field.compare(lo,zero,using:&a) == .equal && field.compare(hi,one,using:&a) == .equal)
            try require(field.compare(targetLo,(!chord && index == 2) ? y:zero,using:&a) == .equal)
            try require(field.compare(targetHi,(!chord && index == 2) ? y:one,using:&a) == .equal)
        }
        if chord { try require(refinement.rawScopeProofs.isEmpty);return }
        let t = try ring.variable(0,using:&a),u = try ring.variable(1,using:&a),v = try ring.variable(2,using:&a)
        let equations = [try ring.subtracting(u,t,using:&a),try ring.subtracting(v,ring.constant(y,using:&a),using:&a)]
        try require(refinement.rawScopeProofs.count == equations.count)
        let rawCells = try Cells(retaining:raw.selection.partition.source,using:&a)
        for law in equations {
            var found = false
            for proof in refinement.rawScopeProofs where try ring.equals(
                ring.normalized(ring.importing(proof.polynomial,using:&a),using:&a),ring.normalized(law,using:&a),using:&a) {
                try require(ring.isZero(ring.importing(proof.remainder,using:&a),using:&a))
                for cell in raw.selection.cells { try require(rawCells.sign(of:proof,at:cell,using:&a) == .zero) }
                found = true
            }
            try require(found)
        }
        let reductions = pullback.region.reductions.filter { $0.variable == 2 && $0.domainRestriction != nil }
        try require(reductions.count == 1)
        let reduction = reductions[0]
        try require(reduction.originalAtoms.count == reduction.derivedAtoms.count)
        let replacements = [t,u,try ring.constant(y,using:&a)]
        for index in reduction.originalAtoms.indices {
            try require(ring.equals(ring.substituted(ring.importing(reduction.originalAtoms[index],using:&a),with:replacements,using:&a),
                ring.importing(reduction.derivedAtoms[index],using:&a),using:&a))
        }
        for law in pullback.target.source.polynomials {
            var found = false
            for originalLaw in reduction.originalAtoms {
                if try ring.equals(ring.importing(originalLaw,using:&a),ring.importing(law,using:&a),using:&a) { found = true;break }
            }
            try require(found)
        }
    }
    static func rawExpected(_ signs:[ExactSign]) -> Bool {
        signs[0] != .negative && signs[1] != .positive && signs[2] != .negative && signs[3] != .positive &&
        signs[4] != .negative && signs[5] != .positive && signs[6] == .zero && signs[7] == .zero
    }
    static func oracle(_ result:Result, expectedCurves:[SurfaceParameterCurve], reverseEdges:Bool = false,
        chord:Bool = false, hole:Bool = false, leftCurve:Int = 2) throws {
        var a = try Fixture.ledger()
        guard case .curveSurface(let raw) = result.parameters.boundary.source else { throw Failure.assertion(#line) }
        try require(raw.pieces.count == 1 && result.parameters.refinements.count == 1 && result.parameters.selection == .closed)
        try checkMap(raw.pieces[0].relation.original.first,surface:false,using:&a)
        try checkMap(raw.pieces[0].relation.original.second,surface:true,using:&a)
        try require(result.original.validationLevel == .exact && result.loops.count == (hole ? 2:1))
        try require(result.loops[0].role == .outer && result.loops[0].coedges.count == expectedCurves.count)
        for index in expectedCurves.indices {
            let edge = result.loops[0].coedges[index]
            try require(edge.surfaceParameterCurve == expectedCurves[index] && edge.orientation == (reverseEdges ? .reversed:.forward))
        }
        let selected = raw.pieces[0].relation.selection
        let (rawCells,rawProofs) = try proofs(selected.partition,refined:false,chord:false,hole:false,using:&a)
        var signatures:[[ExactSign]] = [], rawCount = 0, rawDimension = -1
        for cell in selected.partition.cells where cell.axis == 2 {
            let signs = try signs(rawProofs,cells:rawCells,cell:cell,using:&a)
            let expected = rawExpected(signs)
            try require(selected.cells.contains(cell) == expected)
            if expected { rawCount += 1; rawDimension = max(rawDimension,cell.dimension) }
        }
        try require(rawCount == selected.cells.count && rawCount > 0 && rawDimension == 1)
        for cell in selected.cells {
            let signs = try signs(rawProofs,cells:rawCells,cell:cell,using:&a)
            try require(!signatures.contains(signs));signatures.append(signs)
        }
        let refined = result.parameters.refinements[0], pullback = refined.parameters.pullback, region = pullback.region
        try scopedOracle(refined,chord:chord,using:&a)
        try require(pullback.coordinateMap == [0,1,2] && region.coordinateCount == 3)
        try require(pullback.source.cells.count == selected.cells.count)
        for index in selected.cells.indices { try require(pullback.source.cells[index] == selected.cells[index]) }
        try require(region.cells.count == region.included.count && region.cells.count == pullback.sourceCellOrdinals.count &&
            region.cells.count == refined.boundarySpans.count)
        let (cells,signProofs) = try proofs(region.partition,refined:true,chord:chord,hole:hole,using:&a)
        var checked = 0, included = 0, left = 0, right = 0, holeLeft = 0, holeRight = 0, maximumDimension = -1
        for cell in region.partition.cells where cell.axis == 2 {
            let indices = region.cells.indices.filter { region.cells[$0] == cell }
            try require(indices.count == 1)
            let index = indices[0], signs = try signs(signProofs,cells:cells,cell:cell,using:&a)
            let expected = rawExpected(signs) && signs[8] != .negative && signs[9] != .positive &&
                (!hole || signs[10] != .positive || signs[11] != .negative)
            try require(region.included[index] == expected)
            let ordinal = pullback.sourceCellOrdinals[index]
            try require(expected ? selected.cells.indices.contains(ordinal):ordinal == -1)
            var spans:[OriginalNativeBoundaryDomain.SpanReference] = []
            if expected {
                try require(signatures[ordinal] == Array(signs.prefix(8)))
                if signs[8] == .zero { spans.append(.init(loopOrdinal:0,curveOrdinal:leftCurve,segmentOrdinal:0));left += 1 }
                if signs[9] == .zero { spans.append(.init(loopOrdinal:0,curveOrdinal:1,segmentOrdinal:0));right += 1 }
                if hole && signs[10] == .zero { spans.append(.init(loopOrdinal:1,curveOrdinal:3,segmentOrdinal:0));holeLeft += 1 }
                if hole && signs[11] == .zero { spans.append(.init(loopOrdinal:1,curveOrdinal:1,segmentOrdinal:0));holeRight += 1 }
                included += 1;maximumDimension = max(maximumDimension,cell.dimension)
            }
            let actual = refined.boundarySpans[index]
            try require(actual.count == spans.count && spans.allSatisfy { actual.contains($0) })
            checked += 1
        }
        try require(checked == region.cells.count && included > 0 && maximumDimension == 1 && left == 1 && right == 1)
        if hole { try require(holeLeft == 1 && holeRight == 1) }
        print("PASS rational quadratic whole-cell raw/refined iff, every source ordinal and all endpoint spans; image1/fiber0")
    }
    static func complete() throws {
        let (raw,owner) = try prepare()
        var a = try Fixture.ledger()
        let result = try Fixture.clip(.curveSurface(raw),owner,&a)
        try oracle(result,expectedCurves:pcurves())
        print("PASS actual exact-validated public closed clipping [1/4,1/2]")
    }
    static func directionControls() throws {
        let (raw,_) = try prepare(), surface = Fixture.plane()
        var a = try Fixture.ledger()
        let reversed = try pcurves().reversed().map { try $0.reversed(tolerance:.standard) }
        let reversedResult = try Fixture.clip(.curveSurface(raw),Fixture.face(surface,[(.outer,reversed)]),&a)
        try oracle(reversedResult,expectedCurves:reversed,leftCurve:0)
        let reverseEdges = try Fixture.clip(.curveSurface(raw),Fixture.face(surface,[(.outer,pcurves())],reversed:true),&a)
        try oracle(reverseEdges,expectedCurves:pcurves(),reverseEdges:true)
        var chord = pcurves()
        chord[2] = .affine(origin:.init(x:0.5,y:0.25),direction:.init(x:-0.5,y:-0.25),startParameter:0,endParameter:1)
        let chordResult = try Fixture.clip(.curveSurface(raw),Fixture.face(surface,[(.outer,chord)]),&a)
        try oracle(chordResult,expectedCurves:chord,chord:true)
        let hole = Fixture.rectangle(3.0/8,7.0/16,vLo:3.0/16,vHi:15.0/64)
        let holeResult = try Fixture.clip(.curveSurface(raw),Fixture.face(surface,[(.outer,pcurves()),(.inner,hole)]),&a)
        try oracle(holeResult,expectedCurves:pcurves(),hole:true)
        print("PASS signed winding, full directed pcurve, no double reversal, chord difference and hole material")
    }
    struct PublicationAdmission: ~Copyable, ExactScalarAdmission {
        var ledger:ExactScalarLedger
        private(set) var storageCalls = 0
        let cancellingCall:Int?
        let cancellingWork:Int?
        init(work:Int = 80_000_000,bytes:Int = 1_073_741_824,cancellingCall:Int? = nil,cancellingWork:Int? = nil) throws {
            ledger = try Fixture.ledger(work:work,bytes:bytes);self.cancellingCall = cancellingCall;self.cancellingWork = cancellingWork
        }
        mutating func checkpoint() throws(ExactScalarFailure) { try ledger.checkpoint() }
        mutating func consumeWork(_ units:Int) throws(ExactScalarFailure) {
            try ledger.consumeWork(units)
            if let cancellingWork,ledger.work>=cancellingWork { ledger.cancel() }
        }
        mutating func retainStorage(bytes:Int) throws(ExactScalarFailure) {
            try ledger.retainStorage(bytes:bytes);storageCalls += 1
            if storageCalls == cancellingCall { ledger.cancel() }
        }
        mutating func visitCell(axis:ExactScalarRootAxis,depth:Int) throws(ExactScalarFailure) { try ledger.visitCell(axis:axis,depth:depth) }
        mutating func admitDepth(value:Int,coefficient:Int) throws(ExactScalarFailure) { try ledger.admitDepth(value:value,coefficient:coefficient) }
    }
#if canImport(Darwin) && !hasFeature(Embedded)
    /// Forwards the unchanged query budget and records only a failed depth admission.
    struct TraceAdmission: ~Copyable, ExactScalarAdmission {
        var ledger:ExactScalarLedger
        init(ledger:consuming ExactScalarLedger) { self.ledger = ledger }
        mutating func checkpoint() throws(ExactScalarFailure) { try ledger.checkpoint() }
        mutating func consumeWork(_ units:Int) throws(ExactScalarFailure) { try ledger.consumeWork(units) }
        mutating func retainStorage(bytes:Int) throws(ExactScalarFailure) { try ledger.retainStorage(bytes:bytes) }
        func record(_ request:String) {
            fputs("FAILED ADMISSION \(request) work=\(ledger.work) storage=\(ledger.storageBytes) reachedValue=\(ledger.valueDepth) reachedCoefficient=\(ledger.coefficientDepth)\n",stderr)
            for frame in Thread.callStackSymbols { fputs(frame+"\n",stderr) }
        }
        mutating func visitCell(axis:ExactScalarRootAxis,depth:Int) throws(ExactScalarFailure) {
            do { try ledger.visitCell(axis:axis,depth:depth) }
            catch { record("visitCell axis=\(axis) depth=\(depth)");throw error }
        }
        mutating func admitDepth(value:Int,coefficient:Int) throws(ExactScalarFailure) {
            do { try ledger.admitDepth(value:value,coefficient:coefficient) }
            catch { record("admitDepth value=\(value) coefficient=\(coefficient)");throw error }
        }
    }
    static func traceDepth() throws {
        var setup = try Fixture.ledger()
        let field = try Field.base(field:Base(),maximumExtensionLevel:10,using:&setup)
        let surface = Fixture.plane()
        let raw = try Fixture.raw(Fixture.line(y:7.0/32),surface,field,&setup)
        let owner = try Fixture.face(surface,[(.outer,pcurves())])
        try require(owner.0.validationLevel == .exact)
        var trace = TraceAdmission(ledger:consume setup)
