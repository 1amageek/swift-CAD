    static func resourceControls() throws {
        let (raw,owner) = try prepare(), source = OriginalExactNativeBoundarySource.curveSurface(raw)
        var measured = try PublicationAdmission()
        _ = try Fixture.clip(source,owner,&measured)
        let work = measured.ledger.work, bytes = measured.ledger.storageBytes, finalCall = measured.storageCalls
        try require(work > 0 && bytes > 0 && finalCall > 0)
        var exact = try PublicationAdmission(work:work,bytes:bytes)
        _ = try Fixture.clip(source,owner,&exact)
        try require(exact.ledger.work == work && exact.ledger.storageBytes == bytes)
        for mode in 0..<3 {
            var a = try Fixture.ledger(work:mode == 0 ? work-1:work,bytes:mode == 1 ? bytes-1:bytes)
            if mode == 2 { a.cancel() }
            do { _ = try Fixture.clip(source,owner,&a);throw Failure.unexpectedSuccess }
            catch let failure as NativeExactRelationFailure {
                switch (mode,failure) {
                case (0,.scalar(.resourceLimit(.work))),(0,.domain(.scalar(.resourceLimit(.work)))),
                     (1,.scalar(.resourceLimit(.storage))),(1,.domain(.scalar(.resourceLimit(.storage)))),
                     (2,.scalar(.cancelled)):break
                default:throw failure
                }
                let publicFailure = NativeExactGeometryPublicationFailure.published(failure,tolerance:.standard)
                if mode == 2 { try require(publicFailure is CancellationError) }
                else { try require((publicFailure as? KernelError)?.code == .resourceLimitExceeded) }
            }
        }
        var processing = try PublicationAdmission(cancellingWork:max(1,work/2))
        do { _ = try Fixture.clip(source,owner,&processing);throw Failure.unexpectedSuccess }
        catch NativeExactRelationFailure.scalar(.cancelled) {}
        var final = try PublicationAdmission(cancellingCall:finalCall)
        do { _ = try Fixture.clip(source,owner,&final);throw Failure.unexpectedSuccess }
        catch NativeExactRelationFailure.scalar(.cancelled) {}
#if !hasFeature(Embedded)
        print("METRIC work",work,"storage",bytes,"finalStorageCall",finalCall)
#endif
        print("PASS changed-path exact work/storage N succeeds, N-1 typed causes, entry/processing/final cancellation")
    }
    static func lifetimeControls() async throws {
        let retained:Result
        do {
            let (raw,owner) = try prepare()
            var a = try Fixture.ledger()
            retained = try Fixture.clip(.curveSurface(raw),owner,&a)
        }
        try oracle(retained,expectedCurves:pcurves())
        try await withThrowingTaskGroup(of:Void.self) { group in
            for _ in 0..<2 { group.addTask { try oracle(retained,expectedCurves:pcurves()) } }
            try await group.waitForAll()
        }
        print("PASS retained original source/face after local scope and concurrent readers with independent ledgers")
    }
