    static func chordOracle(_ result:Result,first:Point2D,last:Point2D,includesChord:Bool,reversed:Bool) throws {
        var a=try Fixture.ledger()
        guard case .curveSurface(let raw)=result.parameters.boundary.source else { throw Failure.assertion(#line) }
        try require(raw.pieces.count==1 && result.parameters.refinements.count==1)
        let refined=result.parameters.refinements[0],region=refined.parameters.pullback.region
        let cells=try Cells(retaining:region.partition.source,using:&a),ring=cells.polynomials
        let field=try cells.coefficientField(of:region.partition.source,using:&a)
        let t=try ring.variable(0,using:&a),u=try ring.variable(1,using:&a),v=try ring.variable(2,using:&a)
        let one=try ring.constant(field.integer(1,using:&a),using:&a)
        func coordinate(_ first:Double,_ last:Double) throws -> ExactPolynomial<Field> {
            try ring.adding(ring.constant(field.binary64(exactly:first,using:&a),using:&a),
                ring.scaled(t,by:field.binary64(exactly:last-first,using:&a),using:&a),using:&a)
        }
        let laws=[t,try ring.subtracting(t,one,using:&a),try ring.subtracting(u,coordinate(first.x,last.x),using:&a),
            try ring.subtracting(v,coordinate(first.y,last.y),using:&a)]
        var proofs:[ExactRealCellSignInvariant<Base>]=[]
        for law in laws { guard let proof=try cells.signInvariant(for:law,in:region.partition,using:&a) else { throw Failure.assertion(#line) };proofs.append(proof) }
        var count=0,interior=0,ends=0
        for cell in region.partition.cells where cell.axis==2 {
            let indices=region.cells.indices.filter { region.cells[$0]==cell };try require(indices.count==1)
            let index=indices[0],signs=try proofs.map { try cells.sign(of:$0,at:cell,using:&a) }
            let on=signs[0] != .negative && signs[1] != .positive && signs[2] == .zero && signs[3] == .zero
            let endpoint=on && (signs[0] == .zero || signs[1] == .zero)
            let expected=on && (includesChord || endpoint)
            try require(region.included[index]==expected)
            let spans=refined.boundarySpans[index]
            if expected {
                count += 1
                if endpoint {
                    ends += 1
                    let left=signs[0] == .zero
                    let curve=reversed ? (left ? 0:1):(left ? 2:1)
                    let arc=reversed ? 2:0
                    let expectedSpans=[OriginalNativeBoundaryDomain.SpanReference(loopOrdinal:0,curveOrdinal:curve,segmentOrdinal:0),
                        .init(loopOrdinal:0,curveOrdinal:arc,segmentOrdinal:0)]
                    try require(spans.count==2 && expectedSpans.allSatisfy { spans.contains($0) })
                } else { interior += 1;try require(spans.isEmpty) }
            } else { try require(spans.isEmpty && refined.parameters.pullback.sourceCellOrdinals[index] == -1) }
        }
        try require(count>0 && ends==2 && (includesChord ? interior>0:interior==0))
    }
