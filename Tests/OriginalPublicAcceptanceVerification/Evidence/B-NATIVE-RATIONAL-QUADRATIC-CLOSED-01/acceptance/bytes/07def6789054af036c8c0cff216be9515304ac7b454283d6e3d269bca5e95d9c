    defines=['NATIVE_DOMAIN_ISOLATED_VERIFICATION','NATIVE_FAMILY_ISOLATED_VERIFICATION','SOURCE_ISSUED_MAP_ISOLATED_VERIFICATION','L6_ISOLATED_VERIFICATION']
    domain_dir=compile_module('NativeDomainAdapters',selected,defines,args.reuse_domain)
