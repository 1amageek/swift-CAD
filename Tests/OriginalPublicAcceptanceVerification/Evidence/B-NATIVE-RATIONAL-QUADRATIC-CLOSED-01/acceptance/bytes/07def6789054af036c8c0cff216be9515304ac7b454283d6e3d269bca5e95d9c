    old_fixture=root/'Tests/OriginalPublicAcceptanceVerification/NativeCollapsedBoundaryAcceptance.swift'
    assert link.count(str(old_fixture))==1;link[link.index(str(old_fixture))]=str(fixture)
    link[1:1]=['-I',str(domain_dir),'-I',str(source_dir)]
    old_archive=next(n for n in link if n.endswith('/libNativeDomainAdapters.a'))
    link[link.index(old_archive)]=str(domain_dir/'libNativeDomainAdapters.a')
    link.append(str(source_dir/'libQuadraticBoundarySources.a'))
    if args.reuse_product:
        directory=args.reuse_product.resolve();receipt_path=directory/'receipt.json';r=read(receipt_path)
        admit(receipt_path,sha(receipt_path))
        assert r['success'] and r['lane']==args.lane and r['freshProduction']==fresh
        assert r['checks'][str(fixture)]==sha(fixture)
        for n,h in r['checks'].items():
            path=Path(n)
            if path.is_file() and sha(path)==h:admit(path,h);continue
            assert path==Path(__file__).resolve(),'Unavailable reused product premise: '+n
            snapshot=directory/path.name
            admit(snapshot,h);historical[n]=dict(path=str(snapshot),sha256=h)
        for n,h in r['products'].items():admit(n,h);products[n]=h
        product=next(Path(n) for n in r['products'] if Path(n).name in ['Acceptance','Acceptance.wasm'])
        save('reused-product.json',dict(receipt=str(receipt_path),receiptSHA256=sha(receipt_path),product=str(product),sha256=sha(product)))
    else:
        product=out/('Acceptance.wasm' if args.lane in ['wasm','embedded'] else 'Acceptance')
        link[link.index('-o')+1]=str(product);save('compile-command.json',link)
