    {
      "@id": "ea:session/2026-07-23_geometry-completion-audit/evidence/E006",
      "@type": "Evidence",
      "title": "Inner-support plane-torus section is a complete nodal graph",
      "content": "Exact axial and oblique inner-support sections each produce two bounded mixed self-loop branches sharing one contact with four distinct one-sided tangents. The focused SurfaceSurfaceIntersectionTests suite executed 16 tests with 16 successes, including nearby non-nodal guards, differential checks, dual-pcurve reconstruction, serialization, and tamper rejection. The full CADGeometry suite passed in 301.912 seconds; the downstream analytic-pair Topology suite passed 9/9 and the capability contract passed 10/10 after adding a typed unsupported boundary for nonregular nodal area integration.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "source": "CertifiedPlaneTorusIntersectionCurve.swift and focused xcodebuild test output",
      "sourceUrl": "repo:Tests/CADGeometryTests/SurfaceSurfaceIntersectionTests.swift",
      "reliability": 0.99,
      "supports": ["ea:session/2026-07-23_geometry-completion-audit/insight/I002"]
    },
    {
      "@id": "ea:session/2026-07-23_geometry-completion-audit/insight/I002",
      "@type": "Insight",
      "title": "A plane-torus discriminant double root can encode a nodal curve graph",
      "content": "At exact inner support, the double discriminant root is not an absent or undefined intersection. It is the shared endpoint of two regular-interior self-loop edges, so a complete intersection API must expose the nodal graph and its one-sided differentials.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "derivedFrom": [
        "ea:session/2026-07-23_geometry-completion-audit/topic/T003",
        "ea:session/2026-07-23_geometry-completion-audit/evidence/E006"
      ],
