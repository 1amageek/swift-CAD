    {
      "@id": "ea:session/2026-07-23_geometry-completion-audit/insight/I001",
      "@type": "Insight",
      "title": "Coordinate singularity must be separated from geometric singularity",
      "content": "A failure of one torus meridian as a global free coordinate is insufficient to classify the geometry. The symmetric orthogonal fixture contains genuine second-order branch contacts and therefore requires an exact branch-aware representation rather than only a coordinate switch.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.93,
      "derivedFrom": [
        "ea:session/2026-07-23_geometry-completion-audit/topic/T003",
        "ea:session/2026-07-23_geometry-completion-audit/topic/T004",
        "ea:session/2026-07-23_geometry-completion-audit/evidence/E003",
        "ea:session/2026-07-23_geometry-completion-audit/evidence/E004"
      ],
      "rationale": "The current diagnostic is emitted from an implicit-function denominator and root-count precondition tied to the chosen meridian coordinate, not from a direct rank test of the two surface normals along the full three-dimensional intersection.",
      "supportsClaim": ["ea:session/2026-07-23_geometry-completion-audit/topic/T006"],
      "primaryEvidence": [
        "ea:session/2026-07-23_geometry-completion-audit/evidence/E003",
