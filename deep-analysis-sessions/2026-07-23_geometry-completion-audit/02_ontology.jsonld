    {
      "@id": "ea:session/2026-07-23_geometry-completion-audit/topic/T001",
      "@type": "Topic",
      "title": "Binary exact Geometry completion contract",
      "content": "Geometry is complete only when every required exact capability is implemented, every partial or unregistered requirement is closed, and same-revision verification evidence proves the full scope.",
      "epistemicStatus": "Verified",
      "confidence": 0.98
    },
    {
      "@id": "ea:session/2026-07-23_geometry-completion-audit/topic/T002",
      "@type": "Topic",
      "title": "Current Geometry status is incomplete",
      "content": "The current catalog contains seven Geometry capabilities, of which five are supported and two intersection capabilities remain partial; the global completion contract is at zero of eight gates.",
      "epistemicStatus": "Verified",
      "confidence": 0.99
    },
    {
      "@id": "ea:session/2026-07-23_geometry-completion-audit/topic/T003",
      "@type": "Topic",
      "title": "The exact intersection matrix is not closed",
      "content": "Curve-surface and surface-surface intersection remain partial and the repository does not yet carry complete same-revision matrix and oracle evidence.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.95,
      "causes": "ea:session/2026-07-23_geometry-completion-audit/topic/T002"
    },
    {
      "@id": "ea:session/2026-07-23_geometry-completion-audit/topic/T004",
      "@type": "Topic",
      "title": "General torus-torus meridian coordinate can become singular",
      "content": "The current procedural certificate requires a constant count of simple roots on every meridian of one torus and reports a typed failure when a branch is tangent to that meridian, even before proving the three-dimensional intersection itself is singular.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.82,
      "partOf": "ea:session/2026-07-23_geometry-completion-audit/topic/T003"
    },
    {
      "@id": "ea:session/2026-07-23_geometry-completion-audit/topic/T005",
      "@type": "Topic",
      "title": "Represent congruent centered torus intersections by exact bisector-plane sections",
      "content": "Congruent centered nonparallel tori now factor the difference of their implicit equations into the two axis-bisector planes and reuse certified plane-torus sections while preserving their second-order branch contacts.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "derivedFrom": [
        "ea:session/2026-07-23_geometry-completion-audit/topic/T003",
        "ea:session/2026-07-23_geometry-completion-audit/topic/T004"
      ],
      "rationale": "The factorization is exact for this family and the existing plane-torus representation already provides certified periodic section curves; the generic whole-surface rational fallback exceeded the five-minute test limit.",
      "addresses": "ea:session/2026-07-23_geometry-completion-audit/topic/T004"
    },
