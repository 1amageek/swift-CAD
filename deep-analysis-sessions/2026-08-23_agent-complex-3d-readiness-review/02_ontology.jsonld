    {
      "@id": "insight:composition-root-blocker",
      "@type": "Insight",
      "title": "Compositional closure is the root blocker",
      "content": "The principal limitation is not merely missing feature names: representations produced by supported operations can reach general operations that reject them, so long feature histories cannot rely on closure.",
      "epistemicStatus": "Verified",
      "confidence": 0.97,
      "derivedFrom": [
        "topic:composition",
        "evidence:surface-gap",
        "evidence:boolean-path"
      ],
      "rationale": "The ruled-surface branch now closes through an exact same-parameter representation, but a general non-reducible offset can still connect a supported producer to a general intersection consumer whose advertised representation envelope is broader than its implementation.",
      "inferenceType": "deductive path trace",
      "supportsClaim": [
        "insight:general-not-achieved"
      ]
    },
    {
      "@id": "insight:general-not-achieved",
      "@type": "Insight",
      "title": "General complex-product generation is not achieved",
      "content": "The project cannot yet reliably generate arbitrary complex exact 3D products because the high-dependency composition features remain partial, the general procedural-offset representation envelope is not closed, and the complete Agent-facing selection/query surface is not globally certified.",
      "epistemicStatus": "Verified",
      "confidence": 0.97,
      "derivedFrom": [
        "evidence:ledger",
        "evidence:boolean-path",
        "evidence:query-heuristic",
        "evidence:feature-envelopes",
        "insight:composition-root-blocker"
      ],
      "rationale": "Complex products amplify topology, intersection, selection, and exchange requirements across long edit histories; the current partial areas sit on those critical paths.",
      "inferenceType": "critical-path synthesis",
      "claimRole": "final-claim",
      "primaryEvidence": [
        "evidence:ledger",
