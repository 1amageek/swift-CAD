    {
      "@id": "evidence:kernel-tests",
      "@type": "Evidence",
      "title": "Kernel behavior tests",
      "content": "The most recent full CADKernel suite passed 615 tests. Subsequent periodic-chart ownership changes pass 46 focused tests covering derivative-bounded universal-cover lift, general torus-torus first-through-third differential bounds, general cone-torus periodic lift ownership, certified area/flux, and trimmed analytic volume. The complete optimized SwiftCAD facade bundle passes 181/181 tests after the final chart-lift correction; the full 615-test kernel suite predates it.",
      "epistemicStatus": "Verified",
      "confidence": 0.97,
      "source": "xcodebuild CADKernel test logs",
      "sourceUrl": "file:///tmp/swift-cad-cadkernel-full-rerun.log",
      "reliability": 0.97,
      "supportsClaim": [
        "insight:substrate-strong"
      ]
    },
    {
      "@id": "evidence:curve-validation-performance",
      "@type": "Evidence",
      "title": "Validated curve boundary removes repeated surface hashing",
      "content": "A ValidatedCurve3D certificate now validates a curve once and reuses assuming-valid dispatch during tessellation. Representative poly-spline patch-network tests improved from 104.326 seconds with a timeout to 20.474 seconds, and from more than 60 seconds to 24.564 seconds.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "source": "ValidatedCurve3D.swift, MeshTessellator.swift, and focused xcodebuild test measurements",
      "sourceUrl": "file:///Users/1amageek/Desktop/3D/swift-CAD/Sources/CADGeometry/ValidatedCurve3D.swift",
      "reliability": 0.99,
      "supportsClaim": [
        "insight:substrate-strong",
        "insight:constrained-usable"
      ],
      "chartableData": [
        {
          "seriesLabel": "Before",
          "subject": "polySplineRoundedPatchNetworkPreservesSharedInteriorTopology",
          "value": 104.326,
          "unit": "seconds",
          "period": "2026-08-23",
