      }
    },
    {
      "@id": "insight:constrained-usable",
      "@type": "Insight",
      "title": "Constrained alpha workflows are usable",
      "content": "Within documented envelopes, an external Agent can already generate meaningful parametric products using primitives, sketches, extrude/revolve/loft, selected Booleans, native persistence, STL/GLB, and subset STEP/IGES exchange.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.94,
