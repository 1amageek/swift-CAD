  "session": {
    "id": "2026-08-23_agent-complex-3d-readiness-review",
    "title": "Agent-driven complex 3D product generation readiness",
    "createdAt": "2026-08-23T04:40:00+09:00",
    "updatedAt": "2026-08-23T14:49:00+09:00",
    "appliedFrameworks": [
      "end-to-end capability funnel",
      "compositional closure",
      "release-gate assessment"
    ]
  },
  "@graph": [
    {
      "@id": "topic:product-goal",
      "@type": "Topic",
      "title": "Product goal",
      "content": "An external Agent should be able to construct, edit, query, validate, persist, and exchange complex exact 3D products through a deterministic CAD substrate.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "tags": [
        "goal",
        "agent",
        "cad"
      ],
      "decompositionStrategy": "end-to-end capability funnel"
    },
    {
      "@id": "topic:agent-contract",
      "@type": "Topic",
      "title": "Agent-facing contract",
      "content": "The repository exposes Codable CADCommand and KernelQuery contracts and a SwiftCAD pipeline/builder facade. Natural-language planning and autonomous intent decomposition are outside this repository.",
      "epistemicStatus": "Verified",
      "confidence": 0.96,
      "parent": "topic:product-goal",
      "supports": [
        "insight:substrate-strong"
      ]
    },
    {
      "@id": "topic:capability-coverage",
      "@type": "Topic",
      "title": "Capability coverage",
      "content": "The current ledger reports 67 capabilities: 39 supported and 28 partial. The repository completion rule grants completion only to supported capabilities with complete evidence.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "parent": "topic:product-goal",
      "supports": [
        "insight:general-not-achieved"
      ]
    },
    {
      "@id": "topic:composition",
      "@type": "Topic",
      "title": "Compositional closure",
      "content": "Complex product generation requires an output accepted as supported by one operation to remain valid input for subsequent supported or general operations.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.96,
      "parent": "topic:product-goal",
      "supports": [
        "insight:composition-root-blocker"
      ]
    },
    {
      "@id": "topic:verification",
      "@type": "Topic",
      "title": "Verification state",
      "content": "Product, kernel, facade, and exchange targets compile. The most recent full CADKernel run passed 615/615 tests and CADExchange passed 237/237 tests; changes added afterward passed 46 focused periodic geometry/topology tests. The complete optimized SwiftCAD facade bundle passed 181/181 tests across 69 suites in 244.344 seconds. No formal evidence manifests exist.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "parent": "topic:product-goal",
      "supports": [
        "insight:release-not-ready"
      ]
    },
    {
      "@id": "topic:ideal-target",
      "@type": "Topic",
      "title": "Ideal target state",
      "content": "Every public representation pair and feature composition is behaviorally closed, selection remains stable through edits, external interchange is oracle-tested, and all evidence is produced from one revision.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.91,
      "parent": "topic:product-goal",
      "supports": [
        "insight:ideal-sequence"
      ]
    },
