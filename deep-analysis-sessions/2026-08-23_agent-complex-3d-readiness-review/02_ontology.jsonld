    {
      "@id": "insight:release-not-ready",
      "@type": "Insight",
      "title": "Production and release readiness are not achieved",
      "content": "The current revision cannot be called release-ready because formal gates remain 0/8, evidence manifests and independent external interchange oracles are absent, and 28 capabilities remain partial despite the complete facade run passing.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
